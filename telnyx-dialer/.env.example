# Telnyx API key (Mission Control portal → Account Settings → API Keys). Never expose this to the browser.
TELNYX_API_KEY=KEY0123456789ABCDEF

# ID of the Credential Connection the browser registers against (Voice → SIP Trunking → your connection).
TELNYX_CONNECTION_ID=1234567890123456789

# Telnyx number shown as caller ID, in E.164 format. It must be a number on your Telnyx account.
CALLER_ID_NUMBER=+15551234567

# Who may sign in, as comma-separated user:password pairs.
USERS=alice:change-me-please,bob:another-long-password

# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Destinations users may dial. Numbers must start with one of these prefixes.
ALLOWED_PREFIXES=+1
# Destinations that are always refused even if allowed above (US premium-rate ranges by default).
BLOCKED_PREFIXES=+1900,+1976
# Country code added to numbers typed without a leading +, e.g. 5551234567 → +15551234567.
DEFAULT_COUNTRY_CODE=1

PORT=3000
# Set to true when serving over HTTPS (required for microphone access anywhere except localhost).
SECURE_COOKIES=false
